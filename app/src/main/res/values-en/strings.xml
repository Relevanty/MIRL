    <string name="system_check_title">System check</string>
    <string name="system_check_subtitle">The following permissions are required for alarms and reminders to work reliably.</string>
    <string name="system_check_fix">Fix</string>
    <string name="system_check_refresh">Check again</string>
    <string name="action_system_check">Reliability check</string>
    <string name="system_check_notifications">Notifications</string>
    <string name="system_check_notifications_desc">Show notifications for reminders and alarm alerts.</string>
    <string name="system_check_exact_alarms">Exact alarms</string>
    <string name="system_check_exact_alarms_desc">Trigger alarms and reminders at the exact scheduled time.</string>
    <string name="system_check_battery">Unrestricted battery use</string>
    <string name="system_check_battery_desc">Prevent the system from stopping the app in the background.</string>
    <string name="system_check_dnd">Do Not Disturb access</string>
    <string name="system_check_dnd_desc">Allow the alarm channel to interrupt Do Not Disturb.</string>
    <string name="system_check_overlay">Display over other apps</string>
    <string name="system_check_overlay_desc">Show the alarm screen over the lock screen.</string>
    <string name="system_check_fullscreen">Full-screen alarm</string>
    <string name="system_check_fullscreen_desc">Display the alarm over the lock screen.</string>
    <string name="system_check_fullscreen_xiaomi_desc">On POCO/Xiaomi, allow both “Lock screen” and “Open new windows while running in the background”.</string>
    <string name="required_permissions_title">Required permissions</string>
    <string name="required_permissions_description">Without these permissions, the app cannot guarantee a timely alert, sound or alarm display on the lock screen. Grant them one by one in the system screens.</string>
    <string name="required_permissions_progress">Granted: %1$d of %2$d</string>
    <string name="required_permissions_grant">Allow: %1$s</string>
    <string name="required_permissions_granted">Granted</string>
    <string name="required_permissions_missing">Required</string>
    <string name="required_permissions_footer">After changing a system setting, return to the app — its status will be checked automatically.</string>
    <string name="system_check_hyperos_title">For HyperOS / POCO / Xiaomi</string>
    <string name="system_check_hyperos_body">Also check these phone settings:\n• Security → Permissions → Autostart → enable\n• Security → Boost speed → exclude the app\n• Settings → Battery → app → “No restrictions”</string>
    <string name="system_check_oem_title">Manufacturer-specific settings</string>
    <string name="system_check_oem_subtitle">Complete these steps manually once.</string>
    <string name="system_check_close">Close</string>
    <string name="oem_xiaomi_steps">1. Settings → Apps → Manage apps → Brainord → Battery saver: “No restrictions”.\n2. Enable Autostart.\n3. Other permissions: enable “Show on Lock screen” and “Open new windows while running in the background”.\n4. Lock the app in Recents (press and hold → lock).\n5. Allow exact alarms.</string>
    <string name="oem_samsung_steps">1. Settings → Battery → Background usage limits: remove the app from sleeping apps.\n2. Settings → Battery → Never auto sleeping apps: add the app.\n3. Settings → Apps → Brainord → Battery: “Unrestricted”.\n4. Allow notifications and set the Alarm category to high importance.\n5. Allow exact alarms.</string>
    <string name="oem_huawei_steps">1. Settings → Apps → Apps → Brainord → App launch: disable “Manage automatically”.\n2. Manually enable auto-launch, secondary launch and background activity.\n3. Lock the app in Recents (swipe down → lock).\n4. Allow notifications and lock-screen display.\n5. Allow exact alarms.</string>
    <string name="oem_oneplus_steps">1. Settings → Apps → App management → Brainord → Battery usage: “Allow background activity”.\n2. Enable auto-launch.\n3. Settings → Battery → Battery optimization → app → “Don’t optimize”.\n4. Lock the app in Recents.\n5. Allow exact alarms and notifications.</string>
    <string name="oem_pixel_steps">1. Settings → Apps → Brainord → App battery usage: “Unrestricted”.\n2. Allow Alarms &amp; reminders.\n3. Allow notifications and set the Alarm channel to high priority.\n4. Let alarms interrupt Do Not Disturb.\n5. Allow full-screen notifications.</string>
    <string name="warning_exact_alarms_required">Allow exact alarms or the app may fail to alert you on time.</string>
    <string name="warning_notifications_disabled">Notifications are disabled: the alarm may not open full screen.</string>
    <string name="warning_battery_optimization_enabled">Disable battery optimization for reliable operation.</string>
    <string name="warning_full_screen_intent_disabled">Full-screen display is disabled: the alarm may not appear over the lock screen.</string>
    <string name="warning_dnd_access_disabled">Allow Do Not Disturb access so the alarm is not silenced.</string>
    <string name="error_exact_alarms_required">Cannot start sleep: exact alarms are not allowed.</string>
    <string name="error_required_permissions">Grant all required alarm permissions first.</string>
    <string name="error_plan_not_ready">The sleep plan is not ready yet. Recalculate it.</string>
    <string name="error_failed_to_schedule_alarm">Could not schedule an exact alarm. Check permissions.</string>
    <string name="error_no_cycle_fits">No full sleep cycle fits before the selected time. Reduce the time to fall asleep or choose a later wake-up time.</string>
